  "known_limitations": [
    {
      "id": "aqua_overpass_drift",
      "finding": "MODIS Aqua's median daytime overpass is stable at ~13:52-13:57 local solar time through 2022, then moves later: 14:09 (2023), 14:31 (2024), 15:02 (2025). VIIRS S-NPP stays at 13:46-13:54 throughout. No change around 2020; the drift begins in 2023 and accelerates through 2024-2025.",
      "impact": "Model b was fitted with both sensors at ~13:50. From 2023 MODIS samples a later part of the diurnal fire cycle, so the MODIS-VIIRS relation is not the trained one. This is consistent with (not proven to cause) model b over-predicting 2024 and 2025 (annual error % by year, scored months: {\"2020\": -1.5, \"2021\": -6.5, \"2022\": 2.2, \"2023\": 2.2, \"2024\": 18.6, \"2025\": 11.7}). Affects gap-filled months from 2023 (2024-07). Does not affect the 2003-2011 back-cast or 2012-2022 values.",
      "action": "None taken (diagnostic only, no refit)."
    },
    {
      "id": "modis_version_change",
      "finding": "MODIS version field: 6.2 (2012-2017), 6.03 (2018-2022), 61.03 (2023-2025). VIIRS version is 2 in every year 2012-2025. No version change around 2020 or 2024; the MODIS change in 2023 coincides with the start of the overpass drift, so the two cannot be separated with this data.",
      "action": "None taken."
    },
    {
      "id": "backcast_overpass_assumption",
      "finding": "Aqua's median daytime overpass in 2003-2011 ranges 13:50-13:56 local solar time vs 13:52-13:55 in the 2012-2019 training years (mean 13:54). Largest yearly difference 3 min, tolerance 5 min; for scale the 2025 drift is +69 min. Assumption CONFIRMED.",
      "check": {
        "training_2012_2019_mean": "13:54",
        "training_year_range": [
          "13:52",
          "13:55"
        ],
        "backcast_2003_2011_range": [
          "13:50",
          "13:56"
        ],
        "backcast_minus_training_minutes_by_year": {
          "2003": -3.2,
          "2004": -2.1,
          "2005": -3.1,
          "2006": -0.8,
          "2007": 0.4,
          "2008": 1.5,
          "2009": 2.0,
          "2010": 0.9,
          "2011": -0.3
        },
        "tolerance_minutes": 5.0,
        "drift_2025_minus_training_minutes": 68.8,
        "verdict": "confirmed"
      }
    },
